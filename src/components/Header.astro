---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="brand">
			<div class="theme-toggle-slot">
				<button class="theme-toggle" type="button" aria-label="切换到浅色模式" aria-pressed="true">
					<span class="theme-toggle__track" aria-hidden="true">
						<span class="theme-toggle__icon theme-toggle__icon--moon">
							<svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
								<path
									d="M16.6 15.1A7.25 7.25 0 0 1 8.9 7.4 7.25 7.25 0 1 0 16.6 15.1Z"
									fill="#c8d0ff"></path>
								<path d="M17.6 4.2 18.2 5.5l1.3.6-1.3.6-.6 1.3-.6-1.3-1.3-.6 1.3-.6.6-1.3Z" fill="#8ea2ff"></path>
								<path d="M20.2 10.3 20.5 11l.7.3-.7.3-.3.7-.3-.7-.7-.3.7-.3.3-.7Z" fill="#f7d46f"></path>
							</svg>
						</span>
						<span class="theme-toggle__icon theme-toggle__icon--sun">
							<svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
								<circle cx="12" cy="12" r="4.2" fill="#f7bf3c"></circle>
								<g stroke="#f6a21a" stroke-linecap="round" stroke-width="1.8">
									<path d="M12 3v2"></path>
									<path d="M12 19v2"></path>
									<path d="M5.2 5.2 6.6 6.6"></path>
									<path d="M17.4 17.4 18.8 18.8"></path>
									<path d="M3 12h2"></path>
									<path d="M19 12h2"></path>
									<path d="M5.2 18.8 6.6 17.4"></path>
									<path d="M17.4 6.6 18.8 5.2"></path>
								</g>
							</svg>
						</span>
						<span class="theme-toggle__handle"></span>
					</span>
				</button>
			</div>
			<h2 class="site-title"><a href="/">{SITE_TITLE}</a></h2>
		</div>
		<div class="primary-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="nav-actions">
			<a href="https://github.com/landfallbox" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">访问我的 GitHub 主页</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	.site-title a,
	.site-title a.active {
		text-decoration: none;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}
	.theme-toggle-slot {
		display: flex;
		width: 68px;
		height: 34px;
		align-items: center;
		flex: 0 0 68px;
	}
	nav {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		column-gap: 1rem;
	}
	.site-title,
	.primary-links,
	.nav-actions {
		min-width: 0;
	}
	.site-title {
		justify-self: start;
	}
	.primary-links {
		display: flex;
		justify-self: center;
		justify-content: center;
		align-items: center;
		gap: 0.25rem;
		flex-wrap: wrap;
		max-width: 100%;
	}
	.primary-links a {
		padding: 1em 0.5em;
		color: var(--heading);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	.primary-links a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.nav-actions {
		display: flex;
		justify-self: end;
		align-items: center;
	}
	.theme-toggle {
		display: block;
		width: 68px;
		height: 34px;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
	}
	.theme-toggle__track {
		position: relative;
		display: block;
		width: 68px;
		height: 34px;
		overflow: hidden;
		border-radius: 17px;
		background: #e9f2ff;
		box-shadow: inset 0 0 0 1px rgba(var(--gray), 18%);
	}
	.theme-toggle__track:hover {
		filter: saturate(1.08);
	}
	.theme-toggle__icon {
		position: absolute;
		top: 0;
		display: flex;
		width: 37px;
		height: 34px;
		align-items: center;
		justify-content: center;
		pointer-events: none;
	}
	.theme-toggle__icon--moon {
		left: 0;
		opacity: 0;
	}
	.theme-toggle__icon--sun {
		right: 0;
		opacity: 1;
	}
	.theme-toggle__handle {
		position: absolute;
		top: 2px;
		left: 2px;
		display: block;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 2px 8px rgba(15, 18, 25, 0.22);
	}
	.theme-toggle:focus-visible .theme-toggle__handle {
		box-shadow: 0 0 0 3px rgba(35, 55, 255, 0.32);
	}
	:global(html[data-theme='dark']) .theme-toggle__track {
		background: #151a2d;
	}
	:global(html[data-theme='dark']) .theme-toggle__icon--moon {
		opacity: 1;
	}
	:global(html[data-theme='dark']) .theme-toggle__icon--sun {
		opacity: 0;
	}
	:global(html[data-theme='dark']) .theme-toggle__handle {
		left: 36px;
		background: #f8fbff;
	}
	:global(html.theme-transition-ready) .theme-toggle__track,
	:global(html.theme-transition-ready) .theme-toggle__icon,
	:global(html.theme-transition-ready) .theme-toggle__handle {
		transition:
			background 0.25s,
			opacity 0.25s,
			left 0.25s;
	}
	.nav-actions a {
		display: flex;
		align-items: center;
	}
	.nav-actions a {
		padding: 0.5em 0.35em;
		color: var(--heading);
		text-decoration: none;
	}
	@media (max-width: 720px) {
		nav {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				'brand actions'
				'links links';
			column-gap: 0.75rem;
			row-gap: 0.25rem;
		}
		.brand {
			grid-area: brand;
		}
		.site-title {
			grid-area: unset;
		}
		.primary-links {
			grid-area: links;
			justify-self: center;
			width: 100%;
			max-width: none;
		}
		.nav-actions {
			grid-area: actions;
		}
	}
</style>

<script is:inline>
	const themeToggle = document.querySelector('.theme-toggle');
	const themeColor = document.querySelector('meta[name="theme-color"]');
	const isTheme = (value) => value === 'light' || value === 'dark';
	const getCurrentTheme = () =>
		isTheme(document.documentElement.dataset.theme) ? document.documentElement.dataset.theme : 'light';
	const syncThemeToggle = () => {
		if (!(themeToggle instanceof HTMLButtonElement)) return;

		const isDark = getCurrentTheme() === 'dark';
		themeToggle.setAttribute('aria-pressed', String(isDark));
		themeToggle.setAttribute('aria-label', isDark ? '切换到浅色模式' : '切换到深色模式');
	};
	const applyTheme = (theme) => {
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;
		themeColor?.setAttribute('content', theme === 'dark' ? '#0f131d' : '#ffffff');
	};

	syncThemeToggle();

	themeToggle?.addEventListener('click', () => {
		document.documentElement.classList.add('theme-transition-ready');

		const nextTheme = getCurrentTheme() === 'dark' ? 'light' : 'dark';
		try {
			localStorage.setItem('theme', nextTheme);
		} catch {
			// Ignore storage failures and keep the selected theme for this page view.
		}

		applyTheme(nextTheme);
		syncThemeToggle();
	});

	window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
		try {
			if (localStorage.getItem('theme')) return;
		} catch {
			return;
		}

		applyTheme(event.matches ? 'dark' : 'light');
		syncThemeToggle();
	});
</script>
