---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogPostData = CollectionEntry<'blog'>['data'];
type Heading = {
	depth: number;
	slug: string;
	text: string;
};
type Props = Omit<BlogPostData, 'pubDate' | 'updatedDate' | 'heroImage'> &
	Partial<Pick<BlogPostData, 'pubDate' | 'updatedDate' | 'heroImage'>> & {
		headings?: Heading[];
		showDate?: boolean;
		showHeroImage?: boolean;
		showTableOfContents?: boolean;
	};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	showDate = true,
	showHeroImage = true,
	showTableOfContents = headings.length > 0,
} = Astro.props;
const tocHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 3);
const hasTableOfContents = showTableOfContents;
const tocLabel = `${title}目录`;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				--toc-toggle-size: 2.75rem;
				--toc-edge-gap: 1rem;
				--toc-float-space: calc(var(--toc-toggle-size) + var(--toc-edge-gap) + 1rem);
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.article-title {
				box-sizing: border-box;
				width: 720px;
				max-width: calc(100% - 2em - var(--toc-float-space));
				margin: auto;
				padding: 1em 1em 0;
			}
			.article-shell {
				width: 720px;
				max-width: calc(100% - 2em - var(--toc-float-space));
				margin: auto;
			}
			.prose {
				box-sizing: border-box;
				width: 100%;
				padding: 0 1em 1em;
				color: var(--text);
			}
			.toc {
				box-sizing: border-box;
				position: fixed;
				right: var(--toc-edge-gap);
				bottom: var(--toc-edge-gap);
				z-index: 20;
				width: var(--toc-toggle-size);
				font-size: 0.78em;
				line-height: 1.45;
			}
			.toc-toggle {
				display: flex;
				align-items: center;
				justify-content: center;
				box-sizing: border-box;
				width: var(--toc-toggle-size);
				height: var(--toc-toggle-size);
				margin-left: auto;
				padding: 0;
				border: 1px solid var(--border);
				border-radius: 999px;
				background: var(--surface);
				box-shadow: var(--box-shadow);
				color: var(--heading);
				cursor: pointer;
				font-weight: 700;
			}
			.toc-icon {
				width: 1.25rem;
				height: 1.25rem;
				stroke: currentColor;
				stroke-width: 2;
				stroke-linecap: round;
				stroke-linejoin: round;
				fill: none;
			}
			.toc-panel {
				box-sizing: border-box;
				display: none;
				position: fixed;
				right: var(--toc-edge-gap);
				bottom: calc(var(--toc-edge-gap) + var(--toc-toggle-size) + 0.5rem);
				width: min(18rem, calc(100vw - 2rem));
				max-height: min(65vh, 28rem);
				overflow-y: auto;
				padding: 0.85em 1em;
				border: 1px solid var(--border);
				border-radius: 8px;
				background: var(--surface);
				box-shadow: var(--box-shadow);
			}
			.toc.is-open .toc-panel,
			.toc.is-hover-open .toc-panel {
				display: block;
			}
			.toc ol {
				list-style: none;
				border-left: 0;
				margin: 0;
				padding: 0;
			}
			.toc-title {
				margin: 0 0 0.75em;
				padding: 0 0 0.65em;
				border-bottom: 1px solid var(--border);
				color: var(--heading);
				font-size: 0.95em;
				font-weight: 700;
				line-height: 1.2;
			}
			.toc li + li {
				margin-top: 0.45em;
			}
			.toc a {
				display: block;
				color: var(--muted);
				text-decoration: none;
			}
			.toc a:hover,
			.toc a:focus-visible {
				color: var(--accent);
			}
			.toc-depth-3 {
				position: relative;
				padding-left: 1.25em;
				font-size: 0.94em;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--muted);
			}
			.last-updated-on {
				font-style: italic;
			}
			@media (max-width: 520px) {
				main {
					--toc-toggle-size: 2.5rem;
					--toc-edge-gap: 0.75rem;
					--toc-float-space: calc(var(--toc-toggle-size) + var(--toc-edge-gap) + 0.75rem);
				}
				.article-title,
				.article-shell {
					max-width: calc(100% - 1em - var(--toc-float-space));
				}
			}
			@media (min-width: 1240px) {
				.article-title,
				.article-shell {
					max-width: calc(100% - 2em);
				}
				.toc {
					position: fixed;
					top: 9rem;
					bottom: auto;
					left: calc(50% + 360px + 1.5rem);
					right: auto;
					width: min(280px, calc((100vw - 720px) / 2 - 2rem));
					max-height: calc(100vh - 11rem);
					margin: 0;
				}
				.toc-toggle {
					display: none;
				}
				.toc-panel {
					display: block;
					position: static;
					width: auto;
					max-height: calc(100vh - 11rem);
					margin-top: 0;
					overflow-y: auto;
					padding: 1em 1.05em;
					border: 1px solid var(--border);
					border-radius: 8px;
					background: var(--surface);
					box-shadow: var(--box-shadow);
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{showHeroImage && heroImage && <div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>}
				<div class="article-title">
					<div class="title">
						{showDate && pubDate && <div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										最后更新于 <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>}
						<h1>{title}</h1>
						<hr />
					</div>
				</div>
				<div class="article-shell">
					{hasTableOfContents && <aside class="toc" aria-label={tocLabel} data-toc>
						<button class="toc-toggle" type="button" aria-label="目录" title="目录" aria-expanded="false" aria-controls="toc-panel" data-toc-toggle>
							<svg class="toc-icon" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M8 6h12" />
								<path d="M8 12h12" />
								<path d="M8 18h12" />
								<path d="M4 6h.01" />
								<path d="M4 12h.01" />
								<path d="M4 18h.01" />
							</svg>
						</button>
						<nav class="toc-panel" id="toc-panel" aria-label={tocLabel}>
							<div class="toc-title">{title}</div>
							<ol>
								{tocHeadings.map((heading) => (
									<li class={`toc-depth-${heading.depth}`}>
										<a href={`#${heading.slug}`}>{heading.text}</a>
									</li>
								))}
							</ol>
						</nav>
					</aside>}
					<div class="prose">
					<slot />
					</div>
				</div>
			</article>
		</main>
		{hasTableOfContents && <script is:inline>
			const toc = document.querySelector('[data-toc]');
			const tocToggle = toc?.querySelector('[data-toc-toggle]');
			const wideTocQuery = window.matchMedia('(min-width: 1240px)');
			const hoverTocQuery = window.matchMedia('(hover: hover) and (pointer: fine)');

			if (toc instanceof HTMLElement && tocToggle instanceof HTMLButtonElement) {
				const setTocExpanded = (expanded) => {
					toc.classList.toggle('is-open', expanded);
					tocToggle.setAttribute('aria-expanded', String(expanded));
				};
				const suppressHoverUntilPointerLeaves = () => {
					toc.classList.add('is-hover-suppressed');
				};

				const syncTocState = () => {
					setTocExpanded(wideTocQuery.matches);
				};

				syncTocState();
				wideTocQuery.addEventListener('change', syncTocState);
				tocToggle.addEventListener('click', () => {
					if (!wideTocQuery.matches) {
						const shouldExpand = !toc.classList.contains('is-open');
						toc.classList.remove('is-hover-open');
						setTocExpanded(shouldExpand);
						if (!shouldExpand) {
							suppressHoverUntilPointerLeaves();
						} else {
							toc.classList.remove('is-hover-suppressed');
						}
					}
				});
				toc.addEventListener('pointerenter', () => {
					if (
						!wideTocQuery.matches &&
						hoverTocQuery.matches &&
						!toc.classList.contains('is-open') &&
						!toc.classList.contains('is-hover-suppressed')
					) {
						toc.classList.add('is-hover-open');
					}
				});
				toc.addEventListener('click', (event) => {
					if (!wideTocQuery.matches && event.target instanceof HTMLAnchorElement) {
						setTocExpanded(false);
						toc.classList.remove('is-hover-open');
						suppressHoverUntilPointerLeaves();
					}
				});
				toc.addEventListener('pointerleave', () => {
					toc.classList.remove('is-hover-open');
					toc.classList.remove('is-hover-suppressed');
				});
				document.addEventListener('click', (event) => {
					if (!wideTocQuery.matches && event.target instanceof Node && !toc.contains(event.target)) {
						setTocExpanded(false);
						toc.classList.remove('is-hover-open');
						toc.classList.remove('is-hover-suppressed');
					}
				});
				document.addEventListener('keydown', (event) => {
					if (!wideTocQuery.matches && event.key === 'Escape') {
						setTocExpanded(false);
					}
				});
			}
		</script>}
		<Footer />
	</body>
</html>
