---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id, 'en', { numeric: true }),
);
const latestPosts = posts.slice(0, 3);
const [featuredPost, ...secondaryPosts] = latestPosts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}

			.home-stack {
				display: grid;
				gap: 4rem;
			}

			.hero {
				position: relative;
				display: grid;
				gap: 2rem;
				padding: clamp(2rem, 6vw, 4rem);
				overflow: hidden;
				border: 1px solid var(--border);
				border-radius: 28px;
				background:
					radial-gradient(circle at top right, rgba(var(--accent), 0.16), transparent 34%),
					linear-gradient(135deg, var(--surface), var(--background-soft));
				box-shadow: var(--box-shadow);
			}

			.hero::after {
				position: absolute;
				right: -4rem;
				bottom: -5rem;
				width: 16rem;
				height: 16rem;
				border: 1px solid rgba(var(--accent), 0.18);
				border-radius: 999px;
				content: '';
			}

			.hero__content {
				position: relative;
				z-index: 1;
				max-width: 680px;
			}

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				margin: 0 0 1rem;
				padding: 0.35rem 0.7rem;
				border: 1px solid rgba(var(--accent), 0.24);
				border-radius: 999px;
				background: rgba(var(--accent), 0.08);
				color: rgb(var(--accent));
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.03em;
				text-transform: uppercase;
			}

			.hero h1 {
				max-width: 820px;
				margin: 0;
				font-size: clamp(3rem, 8vw, 5.4rem);
				line-height: 0.95;
				letter-spacing: -0.06em;
			}

			.hero__lead {
				max-width: 640px;
				margin: 1.5rem 0 0;
				color: var(--muted);
				font-size: clamp(1.1rem, 2.4vw, 1.35rem);
				line-height: 1.7;
			}

			.hero__actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.85rem;
				margin-top: 2rem;
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 2.75rem;
				padding: 0 1.15rem;
				border: 1px solid transparent;
				border-radius: 999px;
				font-weight: 700;
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease,
					background 0.2s ease;
			}

			.button:hover {
				transform: translateY(-2px);
				text-decoration: none;
			}

			.button--primary {
				background: rgb(var(--accent));
				color: #fff;
				box-shadow: 0 14px 30px rgba(var(--accent), 0.25);
			}

			.button--primary:hover {
				color: #fff;
				box-shadow: 0 18px 36px rgba(var(--accent), 0.32);
			}

			.button--secondary {
				border-color: var(--border);
				background: var(--surface);
				color: var(--heading);
			}

			.button--secondary:hover {
				border-color: rgba(var(--accent), 0.4);
				color: rgb(var(--accent));
			}

			.section-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.section-header h2 {
				margin: 0;
				font-size: clamp(1.8rem, 4vw, 2.7rem);
				letter-spacing: -0.04em;
			}

			.section-header p {
				max-width: 32rem;
				margin: 0.45rem 0 0;
				color: var(--muted);
			}

			.section-link {
				flex: 0 0 auto;
				font-weight: 700;
				text-decoration: none;
			}

			.post-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
				gap: 1.5rem;
			}

			.post-list {
				display: grid;
				gap: 1.5rem;
			}

			.post-card {
				display: flex;
				min-height: 100%;
				flex-direction: column;
				overflow: hidden;
				border: 1px solid var(--border);
				border-radius: 22px;
				background: var(--surface);
				box-shadow: 0 18px 40px rgba(15, 23, 42, 0.05);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					border-color 0.2s ease,
					box-shadow 0.2s ease;
			}

			.post-card:hover {
				border-color: rgba(var(--accent), 0.35);
				box-shadow: var(--box-shadow);
				transform: translateY(-3px);
				text-decoration: none;
			}

			.post-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.post-card__media {
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: var(--background-soft);
			}

			.post-card__body {
				display: flex;
				flex: 1;
				flex-direction: column;
				gap: 0.65rem;
				padding: 1.25rem;
			}

			.post-card__meta {
				margin: 0;
				color: var(--muted);
				font-size: 0.95rem;
			}

			.post-card h3 {
				margin: 0;
				color: var(--heading);
				font-size: 1.35rem;
				line-height: 1.15;
				transition: color 0.2s ease;
			}

			.post-card--featured h3 {
				font-size: clamp(1.8rem, 4vw, 2.35rem);
				letter-spacing: -0.04em;
			}

			.post-card p {
				margin: 0;
				color: var(--muted);
				line-height: 1.6;
			}

			.post-card__read-more {
				margin-top: auto;
				color: rgb(var(--accent));
				font-weight: 700;
			}

			.post-card:hover h3 {
				color: rgb(var(--accent));
			}

			.info-grid {
			}

			.panel {
				padding: clamp(1.5rem, 4vw, 2rem);
				border: 1px solid var(--border);
				border-radius: 24px;
				background: var(--surface);
			}

			.panel h2,
			.panel h3 {
				margin-top: 0;
				letter-spacing: -0.03em;
			}

			.panel p {
				color: var(--muted);
			}

			.empty-state {
				padding: 2rem;
				border: 1px dashed var(--border);
				border-radius: 20px;
				background: var(--surface);
				color: var(--muted);
			}

			@media (max-width: 820px) {
				.home-stack {
					gap: 3rem;
				}

				.section-header {
					align-items: start;
					flex-direction: column;
				}

				.post-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 520px) {
				.hero {
					padding: 1.5rem;
					border-radius: 22px;
				}

				.hero h1 {
					font-size: 3rem;
				}

				.hero__actions,
				.button {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-stack">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__content">
					<p class="eyebrow">Personal blog</p>
					<h1 id="hero-title">Landfallbox Blog</h1>
					<p class="hero__lead">
						Notes on code, tools, and building things. I use this space to collect engineering
						ideas, development workflows, and learning notes from projects in progress.
					</p>
					<div class="hero__actions" aria-label="Primary actions">
						<a class="button button--primary" href="/blog/">Read the blog</a>
						<a class="button button--secondary" href="/about/">About me</a>
						<a
							class="button button--secondary"
							href="https://github.com/landfallbox"
							target="_blank"
							rel="noopener noreferrer">GitHub</a
						>
					</div>
				</div>
			</section>

			<section aria-labelledby="latest-posts-title">
				<div class="section-header">
					<div>
						<h2 id="latest-posts-title">Latest writing</h2>
						<p>Recent notes and essays from the blog, automatically pulled from the content collection.</p>
					</div>
					<a class="section-link" href="/blog/">View all posts →</a>
				</div>

				{
					featuredPost ? (
						<div class="post-grid">
							<a class="post-card post-card--featured" href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.heroImage && (
									<div class="post-card__media">
										<Image width={720} height={405} src={featuredPost.data.heroImage} alt="" />
									</div>
								)}
								<div class="post-card__body">
									<p class="post-card__meta">
										<FormattedDate date={featuredPost.data.pubDate} />
									</p>
									<h3>{featuredPost.data.title}</h3>
									<p>{featuredPost.data.description}</p>
									<span class="post-card__read-more">Read article →</span>
								</div>
							</a>

							<div class="post-list">
								{
									secondaryPosts.map((post) => (
										<a class="post-card" href={`/blog/${post.id}/`}>
											{post.data.heroImage && (
												<div class="post-card__media">
													<Image width={560} height={315} src={post.data.heroImage} alt="" />
												</div>
											)}
											<div class="post-card__body">
												<p class="post-card__meta">
													<FormattedDate date={post.data.pubDate} />
												</p>
												<h3>{post.data.title}</h3>
												<p>{post.data.description}</p>
											</div>
										</a>
									))
								}
							</div>
						</div>
					) : (
						<p class="empty-state">No posts yet. Add Markdown or MDX files under src/content/blog.</p>
					)
				}
			</section>

			<section class="info-grid" aria-label="About">
				<div class="panel">
					<h2>About Landfallbox</h2>
					<p>
						I’m Landfallbox, and this is where I collect notes from building, learning, and
						experimenting with software. The goal is to keep useful ideas easy to revisit and share.
					</p>
					<a class="section-link" href="/about/">Read more about me →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
