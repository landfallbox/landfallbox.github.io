---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id, 'en', { numeric: true }),
);
const latestPosts = posts.slice(0, 3);
const [featuredPost, ...secondaryPosts] = latestPosts;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}

			.home-stack {
				display: grid;
				gap: 4rem;
			}

			.hero {
				position: relative;
				display: grid;
				gap: 2rem;
				padding: clamp(2rem, 6vw, 4rem);
				overflow: hidden;
				border: 1px solid var(--border);
				border-radius: 28px;
				background:
					radial-gradient(circle at top right, rgba(var(--accent), 0.16), transparent 34%),
					linear-gradient(135deg, var(--surface), var(--background-soft));
				box-shadow: var(--box-shadow);
			}

			.hero::after {
				position: absolute;
				right: -4rem;
				bottom: -5rem;
				width: 16rem;
				height: 16rem;
				border: 1px solid rgba(var(--accent), 0.18);
				border-radius: 999px;
				content: '';
			}

			.hero__content {
				position: relative;
				z-index: 1;
				max-width: 820px;
			}

			.hero h1 {
				max-width: 820px;
				margin: 0;
				font-size: clamp(3rem, 7vw, 5rem);
				line-height: 1.08;
				letter-spacing: 0;
				text-wrap: balance;
			}

			.hero__lead {
				max-width: 640px;
				margin: 1.5rem 0 0;
				color: var(--muted);
				font-size: clamp(1.1rem, 2.4vw, 1.35rem);
				line-height: 1.7;
			}

			.section-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.section-header h2 {
				margin: 0;
				font-size: clamp(1.8rem, 4vw, 2.7rem);
				letter-spacing: -0.04em;
			}

			.section-header p {
				max-width: 32rem;
				margin: 0.45rem 0 0;
				color: var(--muted);
			}

			.section-link {
				flex: 0 0 auto;
				font-weight: 700;
				text-decoration: none;
			}

			.post-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
				gap: 1.5rem;
			}

			.post-list {
				display: grid;
				gap: 1.5rem;
			}

			.post-card {
				display: flex;
				min-height: 100%;
				flex-direction: column;
				overflow: hidden;
				border: 1px solid var(--border);
				border-radius: 22px;
				background: var(--surface);
				box-shadow: 0 18px 40px rgba(15, 23, 42, 0.05);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					border-color 0.2s ease,
					box-shadow 0.2s ease;
			}

			.post-card:hover {
				border-color: rgba(var(--accent), 0.35);
				box-shadow: var(--box-shadow);
				transform: translateY(-3px);
				text-decoration: none;
			}

			.post-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.post-card__media {
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: var(--background-soft);
			}

			.post-card__body {
				display: flex;
				flex: 1;
				flex-direction: column;
				gap: 0.65rem;
				padding: 1.25rem;
			}

			.post-card__meta {
				margin: 0;
				color: var(--muted);
				font-size: 0.95rem;
			}

			.post-card h3 {
				margin: 0;
				color: var(--heading);
				font-size: 1.35rem;
				line-height: 1.15;
				transition: color 0.2s ease;
			}

			.post-card--featured h3 {
				font-size: clamp(1.8rem, 4vw, 2.35rem);
				letter-spacing: -0.04em;
			}

			.post-card p {
				margin: 0;
				color: var(--muted);
				line-height: 1.6;
			}

			.post-card__read-more {
				margin-top: auto;
				color: rgb(var(--accent));
				font-weight: 700;
			}

			.post-card:hover h3 {
				color: rgb(var(--accent));
			}

			.panel {
				padding: clamp(1.5rem, 4vw, 2rem);
				border: 1px solid var(--border);
				border-radius: 24px;
				background: var(--surface);
			}

			.panel h2,
			.panel h3 {
				margin-top: 0;
				letter-spacing: -0.03em;
			}

			.panel p {
				color: var(--muted);
			}

			.empty-state {
				padding: 2rem;
				border: 1px dashed var(--border);
				border-radius: 20px;
				background: var(--surface);
				color: var(--muted);
			}

			@media (max-width: 820px) {
				.home-stack {
					gap: 3rem;
				}

				.section-header {
					align-items: start;
					flex-direction: column;
				}

				.post-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 520px) {
				.hero {
					padding: 1.5rem;
					border-radius: 22px;
				}

				.hero h1 {
					font-size: 2.7rem;
					line-height: 1.12;
				}

			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-stack">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__content">
					<h1 id="hero-title">Landfallbox 的博客</h1>
					<p class="hero__lead">
						记录学习笔记，偶尔分享一些想法。<br/>
						主要是为了便于自己回顾和总结，顺便帮助其他觉得有用的人。
					</p>
				</div>
			</section>

			<section aria-labelledby="latest-posts-title">
				<div class="section-header">
					<div>
						<h2 id="latest-posts-title">最新文章</h2>
					</div>
					<a class="section-link" href="/blog/">查看全部文章 →</a>
				</div>

				{
					featuredPost ? (
						<div class="post-grid">
							<a class="post-card post-card--featured" href={`/blog/${featuredPost.id}/`}>
								{featuredPost.data.heroImage && (
									<div class="post-card__media">
										<Image width={720} height={405} src={featuredPost.data.heroImage} alt="" />
									</div>
								)}
								<div class="post-card__body">
									<p class="post-card__meta">
										<FormattedDate date={featuredPost.data.pubDate} />
									</p>
									<h3>{featuredPost.data.title}</h3>
									<p>{featuredPost.data.description}</p>
									<span class="post-card__read-more">阅读全文 →</span>
								</div>
							</a>

							<div class="post-list">
								{
									secondaryPosts.map((post) => (
										<a class="post-card" href={`/blog/${post.id}/`}>
											{post.data.heroImage && (
												<div class="post-card__media">
													<Image width={560} height={315} src={post.data.heroImage} alt="" />
												</div>
											)}
											<div class="post-card__body">
												<p class="post-card__meta">
													<FormattedDate date={post.data.pubDate} />
												</p>
												<h3>{post.data.title}</h3>
												<p>{post.data.description}</p>
											</div>
										</a>
									))
								}
							</div>
						</div>
					) : (
						<p class="empty-state">还没有文章。请在 src/content/blog 下添加 Markdown 或 MDX 文件。</p>
					)
				}
			</section>

			<!-- <section class="info-grid" aria-label="关于">
				<div class="panel">
					<h2>关于 Landfallbox</h2>
					<p>
						我是 Landfallbox，这里用来整理我在构建、学习和尝试软件时留下的笔记。
						我希望把有用的想法保存下来，方便以后回看，也方便分享给别人。
					</p>
					<a class="section-link" href="/about/">了解更多关于我 →</a>
				</div>
			</section> -->
		</main>
		<Footer />
	</body>
</html>
