---
import Layout from "../layouts/BlogPost.astro";

const timeline = [
	{
		date: "2024 年 9 月",
		title: "苏州科技大学",
		description:
			"读研究生，研究方向为将强化学习应用到建筑智能中的暖通空调控制。",
	},
	{
		date: "2019 年 9 月",
		title: "南京工业大学",
		description: "读本科，进入计算机科学与技术专业。",
	},
];
---

<Layout
	title="关于我"
	description="关于 Landfallbox 的简短介绍：教育经历、当前工作、建站目的、近期计划和兴趣爱好。"
	showDate={false}
	showHeroImage={false}
>
	<style>
		.timeline {
			position: relative;
			display: grid;
			gap: 0;
			margin: 2.5rem 0 3rem;
			padding: 0.5rem 0;
			list-style: none;
		}

		.timeline::before {
			position: absolute;
			top: 1rem;
			bottom: 1rem;
			left: calc(7.5rem + 0.9rem + 0.75rem);
			width: 3px;
			border-radius: 999px;
			background: linear-gradient(
				to bottom,
				color-mix(in srgb, var(--accent) 30%, transparent),
				color-mix(in srgb, var(--accent) 85%, transparent),
				color-mix(in srgb, var(--accent) 30%, transparent)
			);
			box-shadow: 0 0 0 4px
				color-mix(in srgb, var(--accent) 8%, transparent);
			content: "";
			transform: translateX(-50%);
		}

		.timeline__item {
			position: relative;
			display: grid;
			grid-template-columns: 7.5rem 1.5rem minmax(0, 1fr);
			gap: 0.9rem;
			padding: 0.35rem 0 1.35rem;
		}

		.timeline__item:last-child {
			padding-bottom: 0.35rem;
		}

		.timeline__date {
			display: block;
			padding-top: 0.85rem;
			color: var(--heading);
			font-size: clamp(1.05rem, 3vw, 1.35rem);
			font-weight: 800;
			letter-spacing: -0.02em;
			line-height: 1;
			text-align: right;
		}

		.timeline__marker {
			position: relative;
			z-index: 1;
			display: flex;
			justify-content: center;
			padding-top: 0.9rem;
		}

		.timeline__marker::before {
			width: 0.85rem;
			height: 0.85rem;
			border: 3px solid var(--background);
			border-radius: 999px;
			background: var(--accent);
			box-shadow: 0 0 0 4px
				color-mix(in srgb, var(--accent) 16%, transparent);
			content: "";
		}

		.timeline__card {
			position: relative;
			padding: 1.1rem 1.2rem;
			border: 1px solid var(--border);
			border-radius: 18px;
			background: linear-gradient(
				135deg,
				var(--surface),
				var(--background-soft)
			);
			box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
		}

		.timeline__card::before {
			position: absolute;
			top: 1.05rem;
			left: -0.5rem;
			width: 0.85rem;
			height: 0.85rem;
			border-bottom: 1px solid var(--border);
			border-left: 1px solid var(--border);
			background: var(--surface);
			transform: rotate(45deg);
			content: "";
		}

		.timeline__card h3 {
			margin: 0 0 0.45rem;
			font-size: 1.25rem;
			letter-spacing: -0.02em;
		}

		.timeline__card p {
			margin: 0;
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.65;
		}

		.hobby-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1rem;
			margin: 1rem 0 0;
		}

		.hobby-card {
			padding: 1.1rem 1.2rem;
			border: 1px solid var(--border);
			border-radius: 18px;
			background: linear-gradient(
				135deg,
				var(--surface),
				var(--background-soft)
			);
			box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
		}

		.hobby-card h3 {
			margin: 0 0 0.45rem;
			font-size: 1.15rem;
			letter-spacing: -0.02em;
		}

		.hobby-card p {
			margin: 0;
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.65;
		}

		.hobby-quote {
			margin: 0.9rem 0 0;
			padding: 0.9rem 1rem;
			border-left: 4px solid var(--accent);
			border-radius: 14px;
			background: color-mix(in srgb, var(--accent) 7%, transparent);
		}

		.hobby-quote p {
			color: var(--heading);
			font-style: italic;
		}

		.hobby-quote footer {
			margin-top: 0.5rem;
			color: var(--muted);
			font-size: 0.92rem;
		}

		@media (max-width: 520px) {
			.timeline::before {
				left: calc(4.75rem + 0.65rem + 0.6rem);
			}

			.timeline__item {
				grid-template-columns: 4.75rem 1.2rem minmax(0, 1fr);
				gap: 0.65rem;
			}

			.timeline__date {
				font-size: 1.15rem;
			}

			.timeline__card {
				padding: 1rem;
			}

			.hobby-grid {
				grid-template-columns: 1fr;
			}
		}

		@media (max-width: 390px) {
			.timeline {
				padding-left: 0;
			}

			.timeline::before {
				left: 0.6rem;
			}

			.timeline__item {
				grid-template-columns: 1.2rem minmax(0, 1fr);
				gap: 0.7rem;
			}

			.timeline__date {
				grid-column: 2;
				padding-top: 0;
				text-align: left;
			}

			.timeline__marker {
				grid-column: 1;
				grid-row: 1 / span 2;
				padding-top: 0.25rem;
			}

			.timeline__card {
				grid-column: 2;
			}

			.timeline__card::before {
				display: none;
			}
		}
	</style>

	<ol class="timeline">
		{
			timeline.map((item) => (
				<li class="timeline__item">
					<span class="timeline__date">{item.date}</span>
					<span class="timeline__marker" aria-hidden="true" />
					<div class="timeline__card">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</div>
				</li>
			))
		}
	</ol>

	<section aria-labelledby="now-title">
		<h2 id="now-title">我正在做什么</h2>
		<p>
			主要在写第一篇论文，即将完成。<br />
			我的研究方向主要是建筑智能中的强化学习暖通空调控制（没意思，但是好中）。
			工作之余主要关注大语言模型的最新进展（很热门）。
		</p>
	</section>

	<!-- <section aria-labelledby="blog-purpose-title">
		<h2 id="blog-purpose-title">为什么做这个网站</h2>
		<p>
			主要是为了把学习过程记录下来，便于自己回顾和总结，也方便其他觉得有用的人。
		</p>
	</section> -->

	<section aria-labelledby="next-title">
		<h2 id="next-title">短期计划</h2>
		<p>
			短期计划是毕业后进入企业工作。如果条件允许，我希望在毕业前参加暑期实习或日常实习，
			积累一些实际经验，也更稳妥地为正式工作做准备。
		</p>
	</section>

	<section aria-labelledby="hobbies-title">
		<h2 id="hobbies-title">兴趣爱好</h2>
		<div class="hobby-grid">
			<article class="hobby-card">
				<h3>骑行</h3>
				<p>
					现在骑的是喜德盛 AD300，菜腿努力中
				</p>
			</article>
			<article class="hobby-card">
				<h3>F1</h3>
				<p>
					没有特别支持的车队，但维特尔曾经说过：“每个人都是法拉利车迷。就算他们说自己不是，
					他们也是法拉利车迷。” 不得不说，勒克莱尔确实帅。
				</p>
				<p>
					此外，特别感谢胡闹 P 房提供的观赛渠道。
				</p>
			</article>
		</div>
	</section>
</Layout>
