# Copy this file to .env and fill in local values. Do not commit .env.

# The first available provider in this comma-separated order will be used.
# If empty, providers are tried in the order their OPENAI_PROVIDER_* keys appear below.
OPENAI_PROVIDER_ORDER=primary,fallback

OPENAI_PROVIDER_PRIMARY_API_KEY=
OPENAI_PROVIDER_PRIMARY_MODEL=gpt-4o-mini
OPENAI_PROVIDER_PRIMARY_BASE_URL=https://api.openai.com

OPENAI_PROVIDER_FALLBACK_API_KEY=
OPENAI_PROVIDER_FALLBACK_MODEL=gpt-4o-mini
OPENAI_PROVIDER_FALLBACK_BASE_URL=https://api.openai.com

OPENAI_METADATA_TEMPERATURE=0.2
OPENAI_METADATA_MAX_CHARS=24000

DL_DESCRIPTION_COMMAND=node ./scripts/generate-description.mjs
DL_TAGS_COMMAND=node ./scripts/generate-tags.mjs
DL_NOTES_DIR=../zhihu_series_scraper/notes/dl